model Kudos {
  id          String   @id @default(uuid()) @db.Char(36)
  giverId     String   @db.Char(36) @map("giverid")
  recipientId String   @db.Char(36) @map("recipientid")
  reaction    String   @db.VarChar(16)
  message     String   @db.VarChar(300)
  isHidden    Boolean  @default(false) @map("ishidden")
  createdAt   DateTime @default(now()) @map("createdat")
  giver       People   @relation("KudosGiver", fields: [giverId], references: [id])
  recipient   People   @relation("KudosRecipient", fields: [recipientId], references: [id])

  @@index([isHidden, createdAt])
  @@index([giverId, recipientId, createdAt])
  @@index([giverId, createdAt])
  @@index([recipientId, createdAt])
  @@map("kudos")
}

model MemberShipmentOverlay {
  id          String    @id @default(uuid()) @db.Char(36)
  memberId    String    @db.Char(36) @map("memberid")
  shipmentKey String    @db.VarChar(191) @map("shipmentkey")
  sourceType  String    @db.VarChar(40) @map("sourcetype")
  title       String?   @db.VarChar(180)
  description String?   @db.VarChar(500)
  href        String?   @db.VarChar(500)
  imageUrl    String?   @db.VarChar(500) @map("imageurl")
  shippedAt   DateTime? @map("shippedat")
  isHidden    Boolean   @default(false) @map("ishidden")
  createdAt   DateTime  @default(now()) @map("createdat")
  updatedAt   DateTime  @updatedAt @map("updatedat")
  member      People    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, shipmentKey])
  @@index([memberId, isHidden, shippedAt])
  @@index([sourceType, shipmentKey])
  @@map("membershipmentoverlay")
}

