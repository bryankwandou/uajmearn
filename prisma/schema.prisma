generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Bounties {
  id                 String             @id @default(uuid())
  title              String
  slug               String             @unique
  description        String?            @db.Text
  deadline           DateTime?
  commitmentDate     DateTime? @map("commitmentdate")
  eligibility        Json?
  status             status             @default(OPEN)
  token              String?
  rewardAmount       Float? @map("rewardamount")
  rewards            Json?
  maxBonusSpots      Int                @default(0) @map("maxbonusspots")
  usdValue           Float? @map("usdvalue")
  tokenUsdAtPublish  Float? @map("tokenusdatpublish")
  sponsorId          String @map("sponsorid")
  pocId              String @map("pocid")
  source             Source             @default(NATIVE)
  isPublished        Boolean            @default(false) @map("ispublished")
  isFeatured         Boolean            @default(false) @map("isfeatured")
  isActive           Boolean            @default(true) @map("isactive")
  isArchived         Boolean            @default(false) @map("isarchived")
  createdAt          DateTime           @default(now()) @map("createdat")
  updatedAt          DateTime           @updatedAt @map("updatedat")
  applicationLink    String? @map("applicationlink")
  skills             Json?
  type               BountyType         @default(bounty)
  requirements       String?            @db.Text
  isWinnersAnnounced Boolean            @default(false) @map("iswinnersannounced")
  templateId         String? @map("templateid")
  region             String             @default("Global")
  pocSocials         String? @map("pocsocials")
  hackathonprize     Boolean            @default(false)
  applicationType    ApplicationType    @default(fixed) @map("applicationtype")
  timeToComplete     String? @map("timetocomplete")
  references         Json?
  referredBy         String? @map("referredby")
  publishedAt        DateTime? @map("publishedat")
  isPrivate          Boolean            @default(false) @map("isprivate")
  agentAccess        AgentAccess        @default(HUMAN_ONLY) @map("agentaccess")
  hackathonId        String? @map("hackathonid")
  compensationType   CompensationType   @default(fixed) @map("compensationtype")
  maxRewardAsk       Float? @map("maxrewardask")
  minRewardAsk       Float? @map("minrewardask")
  template           BountiesTemplates? @relation(fields: [templateId], references: [id])
  sponsor            Sponsors           @relation(fields: [sponsorId], references: [id])
  poc                User               @relation("poc", fields: [pocId], references: [id])
  language           String?
  shouldSendEmail    Boolean            @default(true) @map("shouldsendemail")
  isFndnPaying       Boolean            @default(false) @map("isfndnpaying")
  Submission         Submission[]
  SubscribeBounty    SubscribeBounty[]
  Hackathon          Hackathon?         @relation(fields: [hackathonId], references: [id])
  winnersAnnouncedAt DateTime? @map("winnersannouncedat")
  Scouts             Scouts[]
  Comments           Comment[]
  discordMessageIds  Json? @map("discordmessageids")
  telegramMessageIds Json? @map("telegrammessageids")
  ai                 Json?
  publishedBy        String? @map("publishedby")
  XWeeklyThread      String? @map("xweeklythread")
  XStandalonePost    String? @map("xstandalonepost")
  isPro              Boolean            @default(false) @map("ispro")

  @@index([id, slug])
  @@index([pocId])
  @@index([templateId])
  @@index([hackathonId])
  @@index([isPublished, isPrivate])
  @@index([deadline, updatedAt])
  @@index([title])
  @@index([deadline(sort: Asc)], map: "Bounties_deadline_asc_idx")
  @@index([deadline(sort: Desc)], map: "Bounties_deadline_desc_idx")
  @@index([winnersAnnouncedAt(sort: Desc)])
  @@index([isFeatured(sort: Desc)])
  @@index([isPublished, isActive, isArchived, status])
  @@index([isPublished, isActive, isArchived, isPrivate, status])
  @@index([sponsorId, isArchived, isPublished, isActive])
  @@index([isPublished, isActive, isPrivate, hackathonprize])
  @@index([compensationType, usdValue])
  @@index([compensationType, maxRewardAsk])
  @@index([isWinnersAnnounced, isPublished, status])
  @@index([region, isPublished, status])
  @@index([isPublished, isActive, isArchived, isPrivate, type])
  @@index([deadline, isWinnersAnnounced])
  @@index([usdValue, maxRewardAsk])
  @@index([region, isPublished, isActive])
  @@index([sponsorId, isPublished, isActive])
  @@index([isFeatured, deadline])
  @@index([createdAt, isPublished])
  @@index([winnersAnnouncedAt, isWinnersAnnounced])
  @@index([language, compensationType])
  @@index([type, isPublished, isActive, isArchived])
  @@index([isPublished, isActive, isArchived, isPrivate, hackathonprize, type])
  @@index([region, type, isPublished, isActive])
  @@index([deadline, isWinnersAnnounced, type])
  @@index([isWinnersAnnounced, isPrivate, type])
  @@map("bounties")
}

model BountiesTemplates {
  id               String           @id @default(uuid())
  title            String?
  deadline         DateTime?
  slug             String?
  description      String?          @db.Text
  color            String?
  emoji            String?
  isFeatured       Boolean          @default(false) @map("isfeatured")
  isActive         Boolean          @default(true) @map("isactive")
  isArchived       Boolean          @default(false) @map("isarchived")
  createdAt        DateTime         @default(now()) @map("createdat")
  updatedAt        DateTime         @updatedAt @map("updatedat")
  skills           Json?
  type             BountyType       @default(bounty)
  requirements     String?          @db.Text
  region           String           @default("Global")
  applicationType  ApplicationType  @default(fixed) @map("applicationtype")
  status           status           @default(OPEN)
  token            String?
  references       Json?
  referredBy       String? @map("referredby")
  publishedAt      DateTime? @map("publishedat")
  compensationType CompensationType @default(fixed) @map("compensationtype")
  maxRewardAsk     Float? @map("maxrewardask")
  minRewardAsk     Float? @map("minrewardask")
  language         String?
  rewardAmount     Float? @map("rewardamount")
  rewards          Json?
  maxBonusSpots    Int              @default(0) @map("maxbonusspots")
  usdValue         Float? @map("usdvalue")
  sponsorId        String @map("sponsorid")
  pocId            String @map("pocid")
  pocSocials       String? @map("pocsocials")
  source           Source           @default(NATIVE)
  isPublished      Boolean          @default(false) @map("ispublished")
  Bounties         Bounties[]
  sponsor          Sponsors         @relation(fields: [sponsorId], references: [id])
  poc              User             @relation("poc", fields: [pocId], references: [id])

  @@index([isActive, isArchived, type])
  @@index([pocId])
  @@index([sponsorId])
  @@index([type])
  @@map("bountiestemplates")
}

model TokenMetadata {
  id                  String   @id @default(uuid())
  tokenName           String   @db.VarChar(191) @map("tokenname")
  tokenSymbol         String   @unique @db.VarChar(64) @map("tokensymbol")
  mintAddress         String   @unique @db.VarChar(191) @map("mintaddress")
  icon                String   @db.VarChar(2048)
  decimals            Int
  sortOrder           Int      @default(0) @map("sortorder")
  isActive            Boolean  @default(true) @map("isactive")
  isVerifiedOnJupiter Boolean  @default(true) @map("isverifiedonjupiter")
  createdAt           DateTime @default(now()) @map("createdat")
  updatedAt           DateTime @updatedAt @map("updatedat")

  @@index([isActive, sortOrder])
  @@index([sortOrder])
  @@map("tokenmetadata")
}

model Comment {
  id               String            @id @default(uuid())
  message          String            @db.VarChar(5000)
  authorId         String @map("authorid")
  refType          CommentRefType    @default(BOUNTY) @map("reftype")
  refId            String @map("refid")
  isActive         Boolean           @default(true) @map("isactive")
  isArchived       Boolean           @default(false) @map("isarchived")
  isPinned         Boolean           @default(false) @map("ispinned")
  createdAt        DateTime          @default(now()) @map("createdat")
  updatedAt        DateTime          @updatedAt @map("updatedat")
  replyToId        String? @map("replytoid")
  submissionId     String? @map("submissionid")
  type             CommentType       @default(NORMAL)
  author           User              @relation(fields: [authorId], references: [id])
  repliedTo        Comment?          @relation("CommentReplies", fields: [replyToId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replies          Comment[]         @relation("CommentReplies")
  listing          Bounties?         @relation(fields: [refId], references: [id], map: "Comment_Listing_fkey")
  submission       Submission?       @relation(fields: [refId], references: [id], map: "Comment_Submission_fkey")
  pow              PoW?              @relation(fields: [refId], references: [id], map: "Comment_PoW_fkey")
  GrantApplication GrantApplication? @relation(fields: [refId], references: [id], map: "Comment_GrantApplication_fkey")

  @@index([id, refId])
  @@index([authorId])
  @@index([replyToId])
  @@index([refId, isActive, isArchived, type])
  @@index([refId, isActive, isArchived, replyToId])
  @@index([refType, type])
  @@index([updatedAt(sort: Desc)])
  @@index([refId, isPinned])
  @@map("comment")
}

model Grants {
  id                     String             @id @default(uuid())
  title                  String
  slug                   String             @unique
  description            String?            @db.Text
  shortDescription       String?            @db.VarChar(1000) @map("shortdescription")
  token                  String?
  minReward              Float? @map("minreward")
  maxReward              Float? @map("maxreward")
  totalPaid              Float              @default(0) @map("totalpaid")
  historicalApplications Int                @default(0) @map("historicalapplications")
  link                   String?
  sponsorId              String @map("sponsorid")
  pocId                  String @map("pocid")
  isPublished            Boolean            @default(false) @map("ispublished")
  isFeatured             Boolean            @default(false) @map("isfeatured")
  isActive               Boolean            @default(true) @map("isactive")
  isArchived             Boolean            @default(false) @map("isarchived")
  isPaused               Boolean            @default(false) @map("ispaused")
  createdAt              DateTime           @default(now()) @map("createdat")
  updatedAt              DateTime           @updatedAt @map("updatedat")
  skills                 Json?
  logo                   String?
  region                 String             @default("Global")
  sponsor                Sponsors           @relation(fields: [sponsorId], references: [id])
  poc                    User               @relation(fields: [pocId], references: [id])
  questions              Json?
  pocSocials             String? @map("pocsocials")
  status                 GrantStatus        @default(OPEN)
  GrantApplication       GrantApplication[]
  airtableId             String? @map("airtableid")
  avgResponseTime        String?            @default("24h") @map("avgresponsetime")
  isNative               Boolean            @default(false) @map("isnative")
  isPrivate              Boolean            @default(false) @map("isprivate")
  references             Json?
  ai                     Json?
  GrantTranche           GrantTranche[]
  approverRecordId       String? @map("approverrecordid")
  emailSender            String? @map("emailsender")
  replyToEmail           String? @map("replytoemail")
  emailSalutation        String? @map("emailsalutation")
  isPro                  Boolean            @default(false) @map("ispro")
  isST                   Boolean            @default(false) @map("isst")

  @@index([id, slug])
  @@index([pocId])
  @@index([isPublished, isActive, isArchived, status])
  @@index([region, isPublished, isActive])
  @@index([slug])
  @@index([sponsorId, isActive, isArchived, status])
  @@index([createdAt(sort: Desc)])
  @@index([isPublished, isActive, isArchived, isPrivate, status])
  @@index([region, isPublished, isActive, isArchived])
  @@index([sponsorId, isPublished, isActive, isArchived])
  @@index([isFeatured, createdAt])
  @@index([status, isPublished, isActive])
  @@index([region, status, isPublished])
  @@index([minReward, maxReward])
  @@map("grants")
}

model GrantApplication {
  id                  String                 @id @default(uuid())
  userId              String @map("userid")
  grantId             String @map("grantid")
  applicationStatus   GrantApplicationStatus @default(Pending) @map("applicationstatus")
  projectTitle        String @map("projecttitle")
  projectOneLiner     String @map("projectoneliner")
  projectDetails      String                 @db.Text @map("projectdetails")
  projectTimeline     String @map("projecttimeline")
  proofOfWork         String                 @db.Text @map("proofofwork")
  walletAddress       String @map("walletaddress")
  twitter             String?
  github              String?
  milestones          String?                @db.Text
  kpi                 String?                @db.Text
  answers             Json?                  @default("[]")
  createdAt           DateTime               @default(now()) @map("createdat")
  updatedAt           DateTime               @updatedAt @map("updatedat")
  user                User                   @relation(fields: [userId], references: [id])
  grant               Grants                 @relation(fields: [grantId], references: [id])
  label               SubmissionLabels       @default(Pending)
  ask                 Float                  @default(0)
  approvedAmount      Float                  @default(0) @map("approvedamount")
  approvedAmountInUSD Float                  @default(0) @map("approvedamountinusd")
  decidedAt           DateTime? @map("decidedat")
  isCooldownSkipped   Boolean                @default(false) @map("iscooldownskipped")
  totalPaid           Float                  @default(0) @map("totalpaid")
  isShipped           Boolean                @default(false) @map("isshipped")
  paymentDetails      Json? @map("paymentdetails")
  totalTranches       Int                    @default(0) @map("totaltranches")
  like                Json?
  likeCount           Int                    @default(0) @map("likecount")
  Comments            Comment[]
  decidedBy           String? @map("decidedby")
  notes               String?                @db.Text
  ai                  Json?
  GrantTranche        GrantTranche[]
  CreditLedger        CreditLedger[]
  lumaLink            String? @map("lumalink")
  expenseBreakdown    String?                @db.Text @map("expensebreakdown")

  @@index([likeCount])
  @@index([grantId, userId, applicationStatus])
  @@index([applicationStatus, decidedAt])
  @@index([applicationStatus, createdAt])
  @@index([userId, grantId, createdAt])
  @@index([decidedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([approvedAmountInUSD(sort: Desc)])
  @@map("grantapplication")
}

model GrantTranche {
  id               String             @id @default(uuid())
  applicationId    String @map("applicationid")
  grantId          String @map("grantid")
  ask              Float
  walletAddress    String? @map("walletaddress")
  update           String?            @db.Text
  helpWanted       String?            @db.Text @map("helpwanted")
  status           GrantTrancheStatus @default(Pending)
  createdAt        DateTime           @default(now()) @map("createdat")
  updatedAt        DateTime           @updatedAt @map("updatedat")
  GrantApplication GrantApplication   @relation(fields: [applicationId], references: [id])
  Grant            Grants             @relation(fields: [grantId], references: [id])
  approvedAmount   Float? @map("approvedamount")
  decidedAt        DateTime? @map("decidedat")
  paidAt           DateTime? @map("paidat")
  trancheNumber    Int @map("tranchenumber")
  eventPictures    Json? @map("eventpictures")
  eventReceipts    Json? @map("eventreceipts")
  attendeeCount    Int? @map("attendeecount")
  socialPost       String?            @db.VarChar(500) @map("socialpost")
  colosseumLink    String?            @db.VarChar(500) @map("colosseumlink")
  githubRepo       String?            @db.VarChar(500) @map("githubrepo")
  aiReceipts       Json? @map("aireceipts")

  @@index([applicationId])
  @@index([grantId])
  @@map("granttranche")
}

model Submission {
  id                 String           @id @default(uuid())
  link               String?          @db.VarChar(500)
  tweet              String?          @db.VarChar(500)
  status             SubmissionStatus @default(Pending)
  eligibilityAnswers Json?            @default("[]") @map("eligibilityanswers")
  userId             String @map("userid")
  agentId            String? @map("agentid")
  listingId          String @map("listingid")
  isWinner           Boolean          @default(false) @map("iswinner")
  winnerPosition     Int? @map("winnerposition")
  isActive           Boolean          @default(true) @map("isactive")
  isArchived         Boolean          @default(false) @map("isarchived")
  createdAt          DateTime         @default(now()) @map("createdat")
  updatedAt          DateTime         @updatedAt @map("updatedat")
  like               Json?
  likeCount          Int              @default(0) @map("likecount")
  isPaid             Boolean          @default(false) @map("ispaid")
  paymentDetails     Json? @map("paymentdetails")
  otherInfo          String?          @db.Text @map("otherinfo")
  ask                Float?
  telegram           String?          @db.Text
  label              SubmissionLabels @default(Unreviewed)
  rewardInUSD        Float            @default(0) @map("rewardinusd")
  listing            Bounties         @relation(fields: [listingId], references: [id])
  user               User             @relation(fields: [userId], references: [id])
  agent              Agent?           @relation(fields: [agentId], references: [id])
  ogImage            String?          @db.Text @map("ogimage")
  notes              String?          @db.VarChar(10000)
  Comments           Comment[]
  CreditLedger       CreditLedger[]
  ai                 Json?
  paymentSynced      Boolean          @default(false) @map("paymentsynced")

  @@index([id, listingId])
  @@index([isWinner])
  @@index([createdAt, isWinner])
  @@index([createdAt, listingId])
  @@index([likeCount])
  @@index([listingId, isActive, isArchived])
  @@index([listingId, userId, isActive, isArchived])
  @@index([listingId, isWinner, isActive, isArchived])
  @@index([userId, listingId, createdAt])
  @@index([userId, isWinner])
  @@index([userId, isWinner, isActive, isArchived])
  @@index([createdAt(sort: Desc)])
  @@index([likeCount(sort: Desc), createdAt(sort: Desc)])
  @@index([agentId])
  @@map("submission")
}

model Sponsors {
  id               String              @id @default(uuid())
  name             String              @unique
  slug             String              @unique
  logo             String?
  url              String?
  industry         String
  twitter          String?
  bio              String?
  createdAt        DateTime            @default(now()) @map("createdat")
  updatedAt        DateTime            @updatedAt @map("updatedat")
  isArchived       Boolean             @default(false) @map("isarchived")
  isActive         Boolean             @default(true) @map("isactive")
  entityName       String? @map("entityname")
  isVerified       Boolean             @default(false) @map("isverified")
  isCaution        Boolean             @default(false) @map("iscaution")
  verificationInfo Json? @map("verificationinfo")
  Hackathon        Hackathon?
  UserSponsors     UserSponsors[]
  Bounties         Bounties[]
  Templates        BountiesTemplates[]
  Grants           Grants[]
  User             User[]
  UserInvites      UserInvites[]
  chapter          Chapter?

  @@index([id, slug])
  @@index([isVerified])
  @@index([isCaution, isVerified])
  @@index([isActive, isArchived])
  @@map("sponsors")
}

model User {
  id                 String               @id @default(uuid())
  publicKey          String? @map("publickey")
  walletAddress      String? @map("walletaddress")
  email              String               @unique
  username           String?              @unique
  photo              String?              @db.Text
  firstName          String?              @db.VarChar(255) @map("firstname")
  lastName           String?              @db.VarChar(255) @map("lastname")
  createdAt          DateTime             @default(now()) @map("createdat")
  updatedAt          DateTime             @updatedAt @map("updatedat")
  isVerified         Boolean              @default(false) @map("isverified")
  role               String               @default("USER")
  isTalentFilled     Boolean              @default(false) @map("istalentfilled")
  interests          String?              @db.Text
  bio                String?              @db.Text
  twitter            String?              @db.Text
  discord            String?              @db.Text
  github             String?              @db.Text
  linkedin           String?              @db.Text
  website            String?              @db.Text
  telegram           String?              @db.Text
  community          String?              @db.Text
  experience         String?
  location           String?
  locationUpdatedAt  DateTime? @map("locationupdatedat")
  cryptoExperience   String? @map("cryptoexperience")
  workPrefernce      String? @map("workprefernce")
  currentEmployer    String? @map("currentemployer")
  notifications      Json?
  private            Boolean              @default(false)
  skills             Json?
  currentSponsorId   String? @map("currentsponsorid")
  emailVerified      DateTime? @map("emailverified")
  hackathonId        String? @map("hackathonid")
  featureModalShown  Boolean              @default(false) @map("featuremodalshown")
  surveysShown       Json? @map("surveysshown")
  stRecommended      Boolean              @default(false) @map("strecommended")
  acceptedTOS        Boolean              @default(false) @map("acceptedtos")
  peopleId           String?              @unique @map("peopleid")
  currentSponsor     Sponsors?            @relation(fields: [currentSponsorId], references: [id])
  people             People?              @relation("UserToPeople", fields: [peopleId], references: [id])
  UserSponsors       UserSponsors[]
  poc                Bounties[]           @relation("poc")
  templates          BountiesTemplates[]  @relation("poc")
  Comment            Comment[]
  Submission         Submission[]
  Grants             Grants[]
  UserInvites        UserInvites[]
  SubscribeBounty    SubscribeBounty[]
  PoW                PoW[]
  Hackathon          Hackathon?           @relation(fields: [hackathonId], references: [id])
  emailSettings      EmailSettings[]
  TalentRankings     TalentRankings[]
  Scouts             Scouts[]
  GrantApplication   GrantApplication[]
  SubscribeHackathon SubscribeHackathon[]
  isBlocked          Boolean              @default(false) @map("isblocked")
  privyDid           String               @unique @map("privydid")
  isKYCVerified      Boolean              @default(false) @map("iskycverified")
  kycName            String? @map("kycname")
  kycCountry         String? @map("kyccountry")
  kycAddress         String? @map("kycaddress")
  kycDOB             String? @map("kycdob")
  kycIDNumber        String? @map("kycidnumber")
  kycIDType          String? @map("kycidtype")
  kycVerifiedAt      DateTime? @map("kycverifiedat")
  CreditLedger       CreditLedger[]
  blockRationale     String? @map("blockrationale")
  linkedTwitter      Json? @map("linkedtwitter")
  referralCode       String?              @unique @map("referralcode")
  referredById       String? @map("referredbyid")
  referredBy         User?                @relation("UserReferrals", fields: [referredById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  referrals          User[]               @relation("UserReferrals")
  telegramUsers      TelegramUser[]
  emailLogs          emailLogs[]
  isPro              Boolean              @default(false) @map("ispro")
  isAgent            Boolean              @default(false) @map("isagent")
  agentProfile       Agent?
  claimedAgents      Agent[]              @relation("AgentClaimedBy")

  @@index([currentSponsorId])
  @@index([hackathonId])
  @@index([email])
  @@index([username])
  @@index([firstName])
  @@index([lastName])
  @@index([location])
  @@index([referredById])
  @@map("user")
}

model Account {
  userId            String @map("userid")
  type              String
  provider          String
  providerAccountId String @map("provideraccountid")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              People  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("account")
}

model Session {
  sessionToken String   @unique @map("sessiontoken")
  userId       String @map("userid")
  expires      DateTime
  user         People   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
  @@index([userId])
  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtoken")
}

model Scouts {
  id            String   @id @default(uuid())
  userId        String @map("userid")
  listingId     String @map("listingid")
  dollarsEarned Int @map("dollarsearned")
  score         Decimal  @db.Decimal(9, 2)
  invited       Boolean
  skills        Json
  createdAt     DateTime @default(now()) @map("createdat")
  listing       Bounties @relation(fields: [listingId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, listingId])
  @@index([listingId, invited])
  @@index([listingId, score(sort: Desc)])
  @@index([userId, listingId, invited])
  @@index([score(sort: Desc)])
  @@map("scouts")
}

model Agent {
  id              String      @id @default(uuid())
  name            String
  userId          String      @unique @map("userid")
  apiKeyHash      String      @unique @map("apikeyhash")
  apiKeyPrefix    String @map("apikeyprefix")
  claimCodeHash   String      @unique @map("claimcodehash")
  claimCodePrefix String @map("claimcodeprefix")
  status          AgentStatus @default(ACTIVE)
