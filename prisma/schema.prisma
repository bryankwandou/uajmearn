model TranslationCache {
  sourceHash String   @db.Char(40) @map("sourcehash")
  targetLang String   @db.VarChar(8) @map("targetlang")
  sourceLang String   @db.VarChar(8) @map("sourcelang")
  text       String   @db.Text
  createdAt  DateTime @default(now()) @map("createdat")

  @@id([sourceHash, targetLang])
  @@index([createdAt])
  @@map("translationcache")
}

model Feedback {
  id         String   @id @default(uuid()) @db.Char(36)
  memberId   String?  @db.Char(36) @map("memberid")
  pathname   String   @db.VarChar(500)
  message    String   @db.Text
  screenshot String?  @db.Text
  userAgent  String?  @db.VarChar(500) @map("useragent")
  createdAt  DateTime @default(now()) @map("createdat")

  @@index([memberId, createdAt])
  @@index([createdAt])
  @@map("feedback")
}

model ForumTopic {
  id                   String              @id @default(uuid()) @db.Char(36)
  title                String              @db.VarChar(255)
  body                 String              @db.Text
  authorId             String              @db.Char(36) @map("authorid")
  category             String?             @db.VarChar(80)
  launchDate           DateTime? @map("launchdate")
  resolvedAt           DateTime? @map("resolvedat")
  introducedAt         DateTime? @map("introducedat")
  introducedById       String?             @db.Char(36) @map("introducedbyid")
  introducedExternally Boolean             @default(false) @map("introducedexternally")
  acceptedReplyId      String?             @db.Char(36) @map("acceptedreplyid")
  amaHostName          String?             @db.VarChar(120) @map("amahostname")
  amaHostXHandle       String?             @db.VarChar(40) @map("amahostxhandle")
  amaHostPhotoUrl      String?             @db.VarChar(500) @map("amahostphotourl")
  amaScheduledAt       DateTime? @map("amascheduledat")
  amaVideoUrl          String?             @db.VarChar(500) @map("amavideourl")
  isPinned             Boolean             @default(false) @map("ispinned")
  isHidden             Boolean             @default(false) @map("ishidden")
  createdAt            DateTime            @default(now()) @map("createdat")
  updatedAt            DateTime            @updatedAt @map("updatedat")
  author               People              @relation(fields: [authorId], references: [id])
  replies              ForumReply[]
  mentions             ForumTopicMention[]

  @@index([authorId])
  @@index([category])
  @@index([acceptedReplyId])
  @@index([isHidden, isPinned, updatedAt])
  @@index([category, launchDate])
  @@index([category, resolvedAt])
  @@index([category, introducedAt])
  @@index([createdAt])
  @@map("forumtopic")
}

model ForumReply {
  id              String       @id @default(uuid()) @db.Char(36)
  topicId         String       @db.Char(36) @map("topicid")
  parentReplyId   String?      @db.Char(36) @map("parentreplyid")
  authorId        String       @db.Char(36) @map("authorid")
  body            String       @db.Text
  isHidden        Boolean      @default(false) @map("ishidden")
  amaAnsweredAt   DateTime? @map("amaansweredat")
  amaAnsweredById String?      @db.Char(36) @map("amaansweredbyid")
  createdAt       DateTime     @default(now()) @map("createdat")
  updatedAt       DateTime     @updatedAt @map("updatedat")
  topic           ForumTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  parentReply     ForumReply?  @relation("ForumReplyThread", fields: [parentReplyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  childReplies    ForumReply[] @relation("ForumReplyThread")
  author          People       @relation(fields: [authorId], references: [id])

  @@index([topicId, parentReplyId, createdAt])
  @@index([topicId, createdAt])
  @@index([topicId, amaAnsweredAt])
  @@index([parentReplyId])
  @@index([authorId])
  @@map("forumreply")
}

model ForumTopicMention {
  id          String     @id @default(uuid()) @db.Char(36)
  topicId     String     @db.Char(36) @map("topicid")
  memberId    String     @db.Char(36) @map("memberid")
  createdById String     @db.Char(36) @map("createdbyid")
  createdAt   DateTime   @default(now()) @map("createdat")
  topic       ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  member      People     @relation("ForumTopicMentionMember", fields: [memberId], references: [id])
  createdBy   People     @relation("ForumTopicMentionCreator", fields: [createdById], references: [id])

  @@unique([topicId, memberId])
  @@index([memberId, createdAt])
  @@index([createdById])
  @@map("forumtopicmention")
}

model MemberPointEvent {
  id             String   @id @default(uuid()) @db.Char(36)
  memberId       String   @db.Char(36) @map("memberid")
  actorId        String?  @db.Char(36) @map("actorid")
  action         String   @db.VarChar(80)
  points         Int
  sourceType     String   @db.VarChar(80) @map("sourcetype")
  sourceId       String?  @db.VarChar(191) @map("sourceid")
  reason         String   @db.VarChar(255)
  idempotencyKey String   @unique @db.VarChar(191) @map("idempotencykey")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("createdat")

  @@index([memberId, createdAt])
  @@index([actorId])
  @@index([sourceType, sourceId])
  @@index([action])
  @@map("memberpointevent")
}

model MemberPointBalance {
  memberId    String   @id @db.Char(36) @map("memberid")
  totalPoints Int      @default(0) @map("totalpoints")
