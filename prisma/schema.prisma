  @@map("memberpointbalance")
}

model MemberVote {
  id         String   @id @default(uuid()) @db.Char(36)
  voterId    String   @db.Char(36) @map("voterid")
  targetType String   @db.VarChar(80) @map("targettype")
  targetId   String   @db.VarChar(191) @map("targetid")
  value      Int      @default(1)
  createdAt  DateTime @default(now()) @map("createdat")
  updatedAt  DateTime @updatedAt @map("updatedat")

  @@unique([voterId, targetType, targetId])
  @@index([targetType, targetId])
